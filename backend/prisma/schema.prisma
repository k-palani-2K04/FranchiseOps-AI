generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite"
}

model outlets {
  id           Int         @id @default(autoincrement())
  outlet_name  String
  manager_name String
  address      String
  city         String
  state        String
  country      String
  postal_code  String?
  latitude     Float
  longitude    Float
  is_active    Boolean?    @default(true)
  created_at   DateTime?   @default(now())
  updated_at   DateTime?   @default(now())
  sales        sales[]
  users        users[]
  inventory    inventory[]
  staff        staff[]
}

model sales {
  id                  Int       @id @default(autoincrement())
  outlet_id           Int
  sale_date           String
  total_orders        Int
  customer_count      Int
  gross_revenue       Float
  operating_cost      Float
  net_profit          Float
  average_order_value Float
  payment_cash        Float
  payment_card        Float
  payment_upi         Float
  created_at          DateTime? @default(now())
  outlets             outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

model users {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password_hash String
  role          String    @default("MANAGER")
  outlet_id     Int?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())
  outlets       outlets?  @relation(fields: [outlet_id], references: [id], onDelete: SetNull)
}

model inventory {
  id             Int       @id @default(autoincrement())
  outlet_id      Int
  item_name      String
  category       String
  current_stock  Float
  min_threshold  Float
  max_capacity   Float
  unit           String
  unit_price     Float
  status         String    @default("In Stock")
  last_restocked String?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())
  outlets        outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

model staff {
  id                 Int       @id @default(autoincrement())
  outlet_id          Int
  name               String
  role               String
  assigned_job       String    @default("General Operations")
  shift_type         String
  login_time         String    @default("08:00 AM")
  logoff_time        String    @default("04:30 PM")
  hourly_rate        Float
  hours_worked       Float
  performance_rating Float
  status             String    @default("Active")
  email              String?
  phone              String?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @default(now())
  outlets            outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade)
}

model customers {
  id                          Int       @id @default(autoincrement())
  name                        String
  email                       String    @unique
  phone                       String?
  age                         Int?
  gender                      String?
  total_spend                 Float     @default(0.0)
  visit_count                 Int       @default(0)
  calculated_engagement_score Float     @default(0.0)
  segment                     String    @default("Standard")
  created_at                  DateTime? @default(now())
  updated_at                  DateTime? @default(now())
}

model campaigns {
  id                Int                 @id @default(autoincrement())
  name              String
  channel           String
  start_date        String
  end_date          String
  budget            Float
  status            String              @default("Draft")
  targeted_segments String?
  created_at        DateTime?           @default(now())
  updated_at        DateTime?           @default(now())
  marketing_metrics marketing_metrics[]
  roi_reports       roi_reports[]
}

model marketing_metrics {
  id                    Int       @id @default(autoincrement())
  campaign_id           Int
  clicks                Int       @default(0)
  impressions           Int       @default(0)
  pos_sales_conversions Int       @default(0)
  sentiment_score       Float     @default(0.0)
  coupon_redemptions    Int       @default(0)
  recorded_date         String
  created_at            DateTime? @default(now())
  campaigns             campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
}

model roi_reports {
  id                   Int       @id @default(autoincrement())
  campaign_id          Int
  total_spend          Float
  attributed_revenue   Float
  net_roi              Float
  efficiency_ratio     Float
  calculated_timestamp DateTime? @default(now())
  created_at           DateTime? @default(now())
  campaigns            campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
}

// ─── AUDIT AGENT MODELS ───────────────────────────────────────────────────────

model audit_sessions {
  id                    Int                    @id @default(autoincrement())
  outlet_id             Int
  auditor_name          String
  audit_date            String
  status                String                 @default("In Progress") // In Progress | Completed | Escalated
  overall_score         Float                  @default(0)
  max_score             Float                  @default(100)
  pass_fail             String                 @default("Pending") // Pass | Fail | Pending
  hygiene_score         Float                  @default(0)
  food_safety_score     Float                  @default(0)
  sop_score             Float                  @default(0)
  facility_score        Float                  @default(0)
  notes                 String?
  created_at            DateTime?              @default(now())
  updated_at            DateTime?              @default(now())
  checklist_items       audit_checklist_items[]
  findings              audit_findings[]
  media_uploads         audit_media_uploads[]
}

model audit_checklist_items {
  id              Int             @id @default(autoincrement())
  session_id      Int
  category        String          // Hygiene | Food Safety | Opening Procedure | Closing Procedure | SOP
  question        String
  answer          String          @default("Pending") // Pass | Fail | N/A | Pending
  score_weight    Float           @default(5)
  notes           String?
  photo_url       String?
  created_at      DateTime?       @default(now())
  session         audit_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  media_uploads   audit_media_uploads[]
}

model audit_findings {
  id              Int             @id @default(autoincrement())
  session_id      Int
  severity        String          // Critical | High | Medium | Low
  finding_type    String          // Hygiene | Financial | Inventory | Staffing | Facility | SOP
  description     String
  status          String          @default("Open") // Open | In Progress | Resolved
  assigned_to     String?
  due_date        String?
  created_at      DateTime?       @default(now())
  session         audit_sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model audit_media_uploads {
  id          Int                    @id @default(autoincrement())
  session_id  Int
  item_id     Int?
  file_name   String
  file_url    String
  uploaded_at DateTime?              @default(now())
  session     audit_sessions         @relation(fields: [session_id], references: [id], onDelete: Cascade)
  item        audit_checklist_items? @relation(fields: [item_id], references: [id], onDelete: SetNull)
}

model audit_incidents {
  id              Int       @id @default(autoincrement())
  outlet_id       Int
  session_id      Int?
  title           String
  description     String
  incident_type   String    // Facility | Equipment | Safety | Hygiene | POS
  priority        String    @default("Medium") // Critical | High | Medium | Low
  status          String    @default("Open") // Open | In Progress | Resolved
  assigned_to     String?
  reported_date   String
  resolved_date   String?
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now())
}

// ─── AGENTIC AI NOTIFICATION & WORKFLOW MODELS ───────────────────────────────

model business_events {
  id                  Int             @id @default(autoincrement())
  event_type          String          // STOCK_SHORTAGE, LOW_SALES, MISSED_CHECKLIST, COMPLIANCE_ISSUE, SLA_BREACH, etc.
  source_module       String          // Inventory, Sales, Audit, Staff, etc.
  outlet_id           Int?
  payload             String          // JSON string payload
  detected_at         DateTime        @default(now())
  status              String          @default("PROCESSED") // NEW | PROCESSED | IGNORED
  notifications       notifications[]
}

model notification_rules {
  id                  Int       @id @default(autoincrement())
  event_type          String    @unique
  rule_name           String
  priority            String    // LOW | MEDIUM | HIGH | CRITICAL
  channels            String    // JSON or comma-separated e.g. "PUSH,EMAIL"
  sla_minutes         Int       @default(30)
  auto_action_plan    Boolean   @default(true)
  auto_escalate       Boolean   @default(true)
  created_at          DateTime? @default(now())
}

model notification_preferences {
  id                  Int       @id @default(autoincrement())
  user_id             Int       @unique
  email_enabled       Boolean   @default(true)
  push_enabled        Boolean   @default(true)
  sms_enabled         Boolean   @default(true)
  min_priority        String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  updated_at          DateTime? @default(now())
}

model notifications {
  id                  Int             @id @default(autoincrement())
  event_id            Int?
  recipient_id        Int?
  outlet_id           Int?
  title               String
  message             String
  severity            String          @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  channels_sent       String          // e.g. "PUSH,EMAIL"
  status              String          @default("SENT") // SENT | ACKNOWLEDGED | ESCALATED | RESOLVED
  ai_analysis         String?         // AI reasoning output
  recommended_action  String?         // AI recommended action
  retry_count         Int             @default(0)
  acknowledged_at     DateTime?
  acknowledged_by     Int?
  resolved_at         DateTime?
  created_at          DateTime        @default(now())
  business_event      business_events? @relation(fields: [event_id], references: [id], onDelete: SetNull)
  escalations         escalations[]
  action_plans        action_plans[]
}

model escalations {
  id                  Int           @id @default(autoincrement())
  notification_id     Int
  action_plan_id      Int?
  from_user_id        Int?
  to_user_id          Int?
  escalation_level    Int           @default(1) // 1: Manager, 2: Regional Manager, etc.
  reason              String
  status              String        @default("PENDING") // PENDING | ACKNOWLEDGED | RESOLVED
  escalated_at        DateTime      @default(now())
  notification        notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
}

model action_plans {
  id                  Int           @id @default(autoincrement())
  notification_id     Int
  title               String
  description         String
  outlet_id           Int?
  owner_id            Int?
  owner_name          String?
  priority            String        @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  status              String        @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | VERIFIED | CLOSED | OVERDUE | ESCALATED
  progress_percentage Int           @default(0)
  deadline            DateTime?
  evidence_url        String?
  verification_notes  String?
  created_at          DateTime      @default(now())
  closed_at           DateTime?
  notification        notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  action_tasks        action_tasks[]
}

model action_tasks {
  id                  Int          @id @default(autoincrement())
  action_plan_id      Int
  task_description    String
  is_completed        Boolean      @default(false)
  completed_at        DateTime?
  completed_by        String?
  action_plan         action_plans @relation(fields: [action_plan_id], references: [id], onDelete: Cascade)
}

model notification_audit_logs {
  id                  Int       @id @default(autoincrement())
  event_id            Int?
  notification_id     Int?
  action_plan_id      Int?
  actor_id            Int?
  actor_name          String?
  action              String    // DETECTED | ANALYZED | DISPATCHED | ACKNOWLEDGED | ESCALATED | ACTION_PLAN_CREATED | TASK_COMPLETED | RESOLVED
  details             String?   // JSON or text summary
  created_at          DateTime  @default(now())
}

